<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- Keep generated or build output out of any broad Checkstyle file set. -->
    <suppress files="(^|[/\\])(build|out|release)([/\\]|$)" checks=".*"/>
</suppressions>
